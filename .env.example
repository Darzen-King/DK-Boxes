# Anthropic Claude API 金鑰（必填）
# 取得：https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 可選：覆寫使用的 Claude 模型（預設 claude-sonnet-4-6）
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Phase 2 TTS（旁白語音合成）─────────────────────────────────────────────
# 預設使用免費的 edge-tts（先 `pip install edge-tts`）。
# 想升級到 ElevenLabs，填入下面金鑰即可，程式會自動切換、其他不用改。
#
# ElevenLabs：https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 可選：指定配音 voice ID（自己錄的克隆聲音也可放這裡）
# 找你的 voice ID：https://elevenlabs.io/app/voice-library
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_ID_EN=...
# ELEVENLABS_VOICE_ID_TL=...
# ELEVENLABS_MODEL=eleven_multilingual_v2
#
# 可選：覆寫 edge-tts 配音（列出所有：edge-tts --list-voices）
# EDGE_VOICE_EN=en-US-AvaMultilingualNeural
# EDGE_VOICE_TL=fil-PH-BlessicaNeural
